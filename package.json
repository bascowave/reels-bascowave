{
  "name": "reels-bascowave",
  "version": "1.0.0",
  "description": "Fábrica de Reels em motion graphics da @bascowave",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.77.0",
    "@remotion/cli": "4.0.542",
    "@remotion/google-fonts": "^4.0.542",
    "@remotion/media": "^4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "narrar": "node --env-file=.env.local narrar.mjs",
    "narrar:fish": "node --env-file=.env.local narrar-fish.mjs",
    "narrar:gemini": "node --env-file=.env.local narrar-gemini.mjs",
    "tts:info": "node tts-modelos.mjs --list",
    "transcrever": "node --env-file=.env.local transcrever-groq.mjs",
    "transcrever:list": "node transcrever-groq.mjs --list"
  },
  "allowScripts": {
    "esbuild": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bascowave/reels-bascowave.git"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
