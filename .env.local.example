# Chaves de TTS (copie para .env.local — gitignored, nunca commitar)
# O usuário só define as CHAVES. Modelo/voz/style são escolhidos pelo agente (skill tts-escolha)
# e passados por flags; as variáveis abaixo são apenas overrides opcionais.

# ElevenLabs (pago) — voz Paulo: Qrdut83w0Cr152Yb4Xn3
ELEVENLABS_API_KEY=

# Fish Audio (free tier até 30/11/2026) — timestamps por segmento
FISH_API_KEY=

# Gemini 3.8 Flash TTS (free tier AI Studio: 3 RPM / 10k TPM / 10 RPD) — SEM timestamps por palavra
GEMINI_API_KEY=
# GEMINI_API_KEY pode ser o mesmo valor de GOOGLE_API_KEY

# --- Overrides opcionais (o agente já escolhe o melhor; só preencha se quiser fixar) ---
# STABILITY=0.7                 # ElevenLabs: 0-1
# FISH_MODEL=s2.1-pro-free      # s2.1-pro-free | s2.1-pro | s2-pro | drama-3 | s1
# FISH_FORMAT=mp3               # mp3 | opus | wav | pcm
# FISH_VOICE=                   # reference_id da Voice Library
# GEMINI_MODEL=gemini-3.8-flash-tts  # ou gemini-3.8-flash-lite-tts
# GEMINI_VOICE=Kore             # Kore, Charon, Puck, Sulafat...
# GEMINI_STYLE=                 # ex.: "narração clara e envolvente" (comece vazio)
